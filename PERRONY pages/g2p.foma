# grapheme to phoneme

define V    [ a | e | i | o | u | é | ê | â | ô | œ | ä ] ;

define C    [ b | c | ç | d | f | g | h | j | k | m | n | p | q | r | s | t | v | x | z ] ;

define WB   [ .#. | " " ] ;

# -------------- CONSONANTS --------------

# 'pp' -> /p/
define PP           p p -> p ;

# 'bb' -> /b/
define BB           b b -> b ;

# 'tt' -> /t/
define TT           t t -> tː ;

# 'c' -> /s/ (placeholder) before i, e
define softC        c -> S || _ [ e | i | é ] ;

# 'c' -> /k/ elsewhere
define hardC        c -> k ;

# 'cc' -> /k/
define CC           c c -> k ;

# 'qu' -> /k/
define QU           q u -> k ;

# 'g' -> /ʒ/ before i, e
define softG        g -> ʒ || _ [ e | i | é ] ;

# 'gu' -> /g/ before i, e
define GU           g u -> g || _ [ e | i | é ] ;

# 'mm' -> /m/
define MM           m m -> m ;

# 'nn' -> /n/
define NN           n n -> N ;

# 'n' -> /n/ intervocalically
define intervocalN  n (->) N || V _ V ;
define fixN         N -> n ;

# 'gn' -> /ɲ/
define GN           g n -> ɲ ;

# 'vv' -> /v/
define VV           v v -> v ;

# 's' -> /∅/ word-finally, and sometimes liaison
define finalS       s -> 0 || _ WB ;
define liaisonS     s (->) Z || _ WB V ;
define fixZ         Z -> z ;

# 'ss' -> /s/
define SS           s s -> S ;
# define fixS         S -> s ;

# 'ç' -> /s/
define cedilleC     ç -> S ;

# 'x' -> /ks/ intervocalically
define intervocalX  x -> k s || V _ V ;

# 'x' -> /s/ before a consonant
define elsewhereX   x -> s || _ C ;

# 'z' -> /∅/ word-finally
define finalZ       z -> 0 || _ WB ;

# 'ch' -> /ʃ/
define CH           c h -> ʃ ;

# 'tch' -> /t͡ʃ/
define TCH          t c h -> t͡ʃ ;

# 'j' -> /ʒ/
define J            j -> ʒ ;

# 'dj' -> /d͡ʒ/      
define DJ           d j -> d͡ʒ ;

# 'ts' -> /t͡s/
define TS           t s -> t͡s ;

# 'dz' -> /d͡z/
define DZ           d z -> d͡z ;

# 'r' -> /ʁ/ elsewhere
define uvularR      r -> ʁ ;

# 'r' -> /∅/ word-finally
define finalR       r (->) 0 || _ WB ;

# 'rr' -> /ʁ/
define RR           r r -> ʁ ;

# 'h' -> /∅/
define silentH      h -> 0 ;

# 'll' -> /l/
define LL           l l -> l ;

# 'ill' -> /ʎ/
define ILL          i l l -> ʎ ;

# 'cll' -> /kʎ/
define CLL          c l l -> kʎ ;

# 'gll' -> /gʎ/
define GLL          g l l -> gʎ ;

# 'fll' -> /fʎ/
define FLL          f l l -> fʎ ;

# 'y' -> /j/
define regY         y -> j ;

# -------------- VOWELS --------------

# 'i' -> /j/ before a vowel
define prevowelI    i -> j || _ V ;

# 'ì' -> /i/ 
define graveI       ì -> i ;

# 'u' -> /y/ elsewhere
define regU         u -> y ;

# 'ou' -> /w/ before a vowel
define prevowelOU   o u -> w || _ V ;

# 'ou' -> /u/ elsewhere
define OU           o u -> U ;
define fixU         U -> u ;

# 'e' -> /ɛ/ 
define regE         e -> ɛ || _ C C ;

# 'ʁe' -> /ʁɛ/
define RE           ʁ e -> ʁ ɛ ;

# 'eʁ' -> /ɛʁ/
define ER           e ʁ -> ɛ ʁ ;

# 'é' -> /e/ 
define aiguE        é -> E ;
define fixE         E -> e ;

# 'ei' -> /ej/
define EI           e i -> ej ;

# 'eu' -> /ø/
define EU           e u -> ø ;

# 'oe' -> /ø/
define OE           o e -> ø ;

# 'au' -> /o/
define AU           a u -> o ;

# 'à' -> /a/
define graveA       à -> a ;

# 'â' -> /a/
define circA        â -> a ;

# 'ä' -> /a/
define umlautA      ä -> a ;


# 'in' -> /ĩ/
define IN           i n -> ã ;

# 'un' -> /œ̃/
define UN           u n -> œ̃ ;

# 'en' -> /ɛ̃/
define EN           e n -> ɛ̃ ;

# 'eun' -> /ø̃/
define EUN          e u n -> ø̃ ;

# 'on' -> /õ/
define ON           o n -> õ ;

# 'an' -> /ã/
define AN           a n -> ã ;

# -------------- MORPHEMES? --------------

# 't' -> /∅/ word-finally SOMETIMES
define finalT       t (->) 0 || _ WB ;

# 'o' -> /∅/ in -TRO 
define TRO          o -> ə || t r _ WB ;

# 'tel' -> /ti/ word-finally
define TEL          t e l -> t i || _ WB ;

# 'et' -> /ɛt/ word-finally
define ET           e t -> ɛ T || _ WB ;
define fixT         T -> tː ;

# -------------- G2P --------------

define ExMap [ "aveir" -> "{aveir}" || WB _ WB .o. "per" -> "{per}" || WB _ WB .o. "tetes" -> "{tetes}" || WB _ WB .o. "couté" -> "{couté}" || WB _ WB .o. "peillos" -> "{peillos}" || WB _ WB .o. "coups" -> "{coups}" || WB _ WB .o. "premiere" -> "{premiere}" || WB _ WB .o. "su" -> "{su}" || WB _ WB .o. "que" -> "{que}" || WB _ WB .o. "dents" -> "{dents}" || WB _ WB .o. "dzens" -> "{dzens}" || WB _ WB .o. "sopatâ" -> "{sopatâ}" || WB _ WB .o. "est" -> "{est}" || WB _ WB .o. "et" -> "{et}" || WB _ WB .o. "tsamos" -> "{tsamos}" || WB _ WB .o. "trouvà" -> "{trouvà}" || WB _ WB ] ;
define ExFix [ "{aveir}" -> "avej" || WB _ WB .o. "{per}" -> "pə" || WB _ WB .o. "{tetes}" -> "titə" || WB _ WB .o. "{couté}" -> "kuti" || WB _ WB .o. "{peillos}" -> "pidjo" || WB _ WB .o. "{coups}" -> "ku" || WB _ WB .o. "{premiere}" -> "pʁəmi" || WB _ WB .o. "{su}" -> "ʃy" || WB _ WB .o. "{que}" -> "ke" || WB _ WB .o. "{dents}" -> "di" || WB _ WB .o. "{dzens}" -> "dzi" || WB _ WB .o. "{sopatâ}" -> "ʃopata" || WB _ WB .o. "{est}" -> "ɛ" || WB _ WB .o. "{et}" -> "e" || WB _ WB .o. "{tsamos}" -> "tsamoʃ" || WB _ WB .o. "{trouvà}" -> "tʁuwa" || WB _ WB ] ;

define G2P ExMap .o. TCH .o. TS .o. DZ .o. TRO .o. CC .o. VV .o. TT .o. PP .o. BB .o. MM .o. 
    CLL .o. GLL .o. FLL .o. ILL .o.
    GN .o. GU .o. QU .o. 
    DJ .o. J .o. finalR .o. RR .o. uvularR .o. 
    SS .o. softC .o. liaisonS .o. finalS .o. 
    CH .o. LL .o.
    prevowelOU .o. OU .o.
    intervocalN .o. NN .o. EUN .o. UN .o. IN .o. AN .o. ON .o. EN .o. fixN .o.
    EU .o. OE .o. EI .o. 
    intervocalX .o. elsewhereX .o.
    softG .o. hardC .o.
    TEL .o. ET .o. finalT .o. fixT .o. finalZ .o. fixZ .o.
    regY .o. cedilleC .o. silentH .o.
    circA .o. umlautA .o.
    aiguE .o. graveA .o.
    prevowelI .o. 
    AU .o. 
    regE .o. ER .o. RE .o. regU .o.
    fixU .o. fixE .o. ExFix;

regex G2P;

