define V    [ a | e | i | o | u | é | ê | â | ô | œ | ä ] ;

define C    [ b | c | ç | d | f | g | h | j | k | m | n | p | q | r | s | t | v | x | z ] ;

# -------------- CONSONANTS --------------

# 'tt' -> /t/
define TT           t t -> t ;

# 'c' -> /s/ (placeholder) before i, e
define softC        c -> S || _ [ e | i | é ] ;

# 'c' -> /k/ elsewhere
define hardC        c -> k ;

# 'cc' -> /k/
define CC           c c -> k ;

# 'qu' -> /k/
define QU           q u -> k ;

# 'g' -> /ʒ/ before i, e
define softG        g -> ʒ || _ [ e | i | é ] ;

# 'gu' -> /g/ before i, e
define GU           g u -> g || _ [ e | i | é ] ;

# 'n' -> /n/ intervocalically
define intervocalN  n -> N || V _ V ;
define fixN         N -> n ;

# 'gn' -> /ɲ/
define GN           g n -> ɲ ;

# 'vv' -> /v/
define VV           v v -> v ;

# 's' -> /∅/ word-finally, /z/ intervocalically
define finalS       s -> 0 || _ .#. ;
define intervocalS  s -> z || V _ V ;
define liaisonS     s -> z || _ .#. V ;

# 'ss' -> /s/
define SS           s s -> S ;
define fixS         S -> s ;

# 'ç' -> /s/
define cedilleC     ç -> s ;

# 'x' -> /ks/ intervocalically
define intervocalX  x -> k s || V _ V ;

# 'x' -> /s/ before a consonant
define elsewhereX   x -> s || _ C ;

# 'z' -> /∅/ word-finally
define finalZ       z -> 0 || _ .#. ;

# 'ch' -> /ʃ/
define CH           c h -> ʃ ;

# 'tch' -> /t͡ʃ/
define TCH          t c h -> t͡ʃ ;

# 'j' -> /ʒ/
define J            j -> ʒ ;

# 'r' -> /j/ interovcalically
define intervocalR  r -> j || V _ V ;

# 'r' -> /ʁ/ elsewhere
define uvularR      r -> ʁ ;

# 'r' -> /∅/ word-finally
# define finalR     r -> ∅ || _ # ;

# 'rr' -> /ʁ/
define RR           r r -> ʁ ;

# 'h' -> /∅/
define silentH      h -> 0 ;

# 'll' -> /l/
define LL           l l -> l ;

# 'ill' -> /ʎ/
define ILL          i l l -> ʎ ;

# 'cll' -> /kʎ/
define CLL          c l l -> kʎ ;

# 'gll' -> /gʎ/
define GLL          g l l -> gʎ ;

# 'fll' -> /fʎ/
define FLL          f l l -> fʎ ;

# 'y' -> /j/
define regY         y -> j ;

# -------------- VOWELS --------------

# 'i' -> /j/ before a vowel
define prevowelI    i -> j || _ V ;

# 'ì' -> /i/ 
define graveI       ì -> i ;

# 'u' -> /y/ elsewhere
define regU         u -> y ;

# 'ou' -> /w/ before a vowel
define prevowelOU   o u -> w || _ V ;

# 'ou' -> /u/ elsewhere
define OU           o u -> U ;

# 'oue' -> /u/ 
define OUE          o u e -> U ;
define fixU         U -> u ;

# 'e' -> /ɛ/ SOMETIMES??
define regE         e -> ɛ ;

# 'e' -> /ə/ word-finally SOMETIMES
define finalE       e -> ə || _ .#. ;

# 'é' -> /e/ 
define aiguE        é -> E ;
define fixE         E -> e ;

# 'ê' -> /ɛ/
define circE        ê -> ɛ ;

# 'ei' -> /ej/
define EI           e i -> ej ;

# 'eu' -> /ø/
define EU           e u -> ø ;

# 'oe' -> /ø/
define OE           o e -> ø ;

# 'au' -> /o/
define AU           a u -> o ;

# 'à' -> /a/
define graveA       à -> a ;

# 'â' -> /a/
define circA        â -> a ;

# 'ä' -> /a/
define umlautA      ä -> a ;


# 'in' -> /ĩ/
define IN           i n -> ĩ ;

# 'un' -> /œ̃/
define UN           u n -> œ̃ ;

# 'en' -> /ɛ̃/
define EN           e n -> ɛ̃ ;

# 'eun' -> /ø̃/
define EUN          e u n -> ø̃ ;

# 'on' -> /õ/
define ON           o n -> õ ;

# 'an' -> /ã/
define AN           a n -> ã ;

# -------------- MORPHEMES? --------------

# 't' -> /∅/ word-finally SOMETIMES??
define finalT       t -> 0 || _ .#. ;

# 'o' -> /∅/ in -TRO MAYBE GONE
define TRO        o -> ə || t r _ .#. ;

# 'tel' -> /ti/ word-finally
define TEL          t e l -> t i || _ .#. ;

# 'et' -> /ɛt/ word-finally
define ET           e t -> ɛ T || _ .#. ;
define fixT         T -> t ;

# -------------- G2P --------------

define ExMap [ "aveir" -> "{aveir}" || .#. _ .#. .o. "per" -> "{per}" || .#. _ .#. .o. "tetes" -> "{tetes}" || .#. _ .#. .o. "couté" -> "{couté}" || .#. _ .#. .o. "peillos" -> "{peillos}" || .#. _ .#. .o. "coups" -> "{coups}" || .#. _ .#. .o. "premiere" -> "{premiere}" || .#. _ .#. .o. "su" -> "{su}" || .#. _ .#. .o. "que" -> "{que}" || .#. _ .#. .o. "dents" -> "{dents}" || .#. _ .#. .o. "dzens" -> "{dzens}" || .#. _ .#. .o. "sopatâ" -> "{sopatâ}" || .#. _ .#. .o. "est" -> "{est}" || .#. _ .#. .o. "et" -> "{et}" || .#. _ .#. .o. "tsamos" -> "{tsamos}" || .#. _ .#. .o. "trouvà" -> "{trouvà}" || .#. _ .#. ] ;
define ExFix [ "{aveir}" -> "avej" || .#. _ .#. .o. "{per}" -> "pə" || .#. _ .#. .o. "{tetes}" -> "titə" || .#. _ .#. .o. "{couté}" -> "kuti" || .#. _ .#. .o. "{peillos}" -> "pidjo" || .#. _ .#. .o. "{coups}" -> "ku" || .#. _ .#. .o. "{premiere}" -> "pʁəmi" || .#. _ .#. .o. "{su}" -> "ʃy" || .#. _ .#. .o. "{que}" -> "ke" || .#. _ .#. .o. "{dents}" -> "di" || .#. _ .#. .o. "{dzens}" -> "dzi" || .#. _ .#. .o. "{sopatâ}" -> "ʃopata" || .#. _ .#. .o. "{est}" -> "ɛ" || .#. _ .#. .o. "{et}" -> "e" || .#. _ .#. .o. "{tsamos}" -> "tsamoʃ" || .#. _ .#. .o. "{trouvà}" -> "tʁuwa" || .#. _ .#. ] ;

define G2P ExMap .o. TCH .o. TRO .o. CC .o. VV .o. TT .o.
    CLL .o. GLL .o. FLL .o. ILL .o.
    GN .o. GU .o. QU .o. 
    J .o. intervocalR .o. RR .o. uvularR .o. 
    SS .o. softC .o. intervocalS .o. finalS .o. fixS .o.
    CH .o. LL .o.
    prevowelOU .o. OU .o.
    intervocalN .o. EUN .o. UN .o. IN .o. AN .o. ON .o. EN .o. fixN .o.
    EU .o. OE .o. EI .o. 
    intervocalX .o. elsewhereX .o.
    softG .o. hardC .o.
    TEL .o. ET .o. finalT .o. fixT .o. finalZ .o. 
    regY .o. cedilleC .o. silentH .o.
    circE .o. circA .o. umlautA .o.
    aiguE .o. graveA .o.
    prevowelI .o. 
    finalE .o. AU .o. 
    regE .o. regU .o.
    fixU .o. fixE .o. ExFix;

regex G2P;

