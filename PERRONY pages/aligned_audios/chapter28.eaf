                TIME_SLOT_REF1="ts4316" TIME_SLOT_REF2="ts4371">
                <ANNOTATION_VALUE>setembro a cinquanta et dous ans s est remariâ L at acapâ an dzovena di veladzo d Argnod et l at decidâ de torner beuter su fameille</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71"
                TIME_SLOT_REF1="ts4372" TIME_SLOT_REF2="ts4525">
                <ANNOTATION_VALUE>Pensa Sandrine l at contâ Batista que ceta Orbellina Champier l at vingt et sat ans finque un an mouens que mé Me diont que l est tchica simpleta Sé pâs Dze sé renque que les dzovenos de per lé l ant sonâ lei p an semana la tsevalerie coment se fet is vevos mis sont pâs arrevâs a se fére payier a bere Per force liu l at ren Et pi l est un emplatro</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72"
                TIME_SLOT_REF1="ts4526" TIME_SLOT_REF2="ts4591">
                <ANNOTATION_VALUE>Batista l ére pâs tant tendro avouì lo papa naturel et vouillet mantenir la distance torno pi bâs en tchi l avocat Fusinaz vére se me fât torner fére quaques achons legales</ANNOTATION_VALUE>
