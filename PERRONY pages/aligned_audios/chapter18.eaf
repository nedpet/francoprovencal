    <TIER LINGUISTIC_TYPE_REF="default-lt" TIER_ID="default"/>
    <TIER LINGUISTIC_TYPE_REF="default-lt" TIER_ID="Sentence">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>L EST APRIS QUE SONT venues bâs les grousses laventses de fevrier de l an</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3"
                TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts47">
                <ANNOTATION_VALUE>mille huit cent quatre vingt dix sept</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4"
                TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>çala de Quesumaz per aler en Rima et çala enorma de Tchoeril que vint bâs di col de Felumaz queure lo plan passe i tsenail de Tsamptsevalet et arreve en Djouere djeusto devant que La Barmaz et Melignon que Batista l at poussu saluyier lo retor a Sent Dzordo de son grous frére</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5"
                TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>Vitorien apris pi de treis ans de servicho deis lo meis de mai vegnavepi tramouâ dens la comba de Rima Lei faillet donc queter la tsambra a Maisonnasse de Vassavarentse et avouì tchica de regret s elognier de Marceline L ayet dza preis an tsambra a Viou de Sent Dzordo per rester protso de la Meison Comeuna de l éillise de la via comunotera et surtot di burò de la Posta</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
                TIME_SLOT_REF1="ts300" TIME_SLOT_REF2="ts371">
                <ANNOTATION_VALUE>Batista tant content come cen que l ére fier l est alâ lo eidjier a demegnadjier l ayet pâs grousses bagues mis toteun l at falu prendre un meulet et an leudze avouì lo casson</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts467">
                <ANNOTATION_VALUE>Aveir Vitorien garda a Sent Dzordo per Batista l ére un espoer de posseir fére quaques travails ara que s aprotsave a ses dies et huet ans et l ayet pâs d ocupachon foura dis travails de la campagne a eidjier lo viou Tounin alentor de Melignon</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts468" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>Vitorien l ére preu content de torner en tchi liu cougnichet tcheuts l ére prateco dis montagnes sayet coment l érant les situachons dis consorts et les atitudes dis dzens qui l érant les tsacheurs et de tot en poca S ategnave cheur pâs franc quaques dzors devant que se tramouer oficielamente de se vére enmelâ dedens un spetaclo se efreyent</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts599">
                <ANNOTATION_VALUE>L ére lo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10"
                TIME_SLOT_REF1="ts600" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>deux</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11"
                TIME_SLOT_REF1="ts604" TIME_SLOT_REF2="ts695">
                <ANNOTATION_VALUE>d avril un devendro a nou heures di neit foura l ére dza teup et Vitorien que l ére restâ a Viou l ére quase prest a se djére perqué lo lendeman l ayet combinâ devant que torner en Vassavarentse d aler compagnie l atro</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts696" TIME_SLOT_REF2="ts759">
                <ANNOTATION_VALUE>garda Maurice Dayné vére se les laventses l ayant rendu quaques tetes de boquetin Su per les cabanes l ére pâs incora lo cas d aler n ayet trop de nei</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13"
