                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>QUASE DOUS ANS SONT PASSÂS l est arrevâ lo tsâtemps di</ANNOTATION_VALUE>
