    <TIER LINGUISTIC_TYPE_REF="default-lt" TIER_ID="Sentence">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts65">
                <ANNOTATION_VALUE>LÉRE DJEUSTO BEICHÀ de la pousta devant l Hotel Londres a Tsateillon Châtillon l ayet tsardjà su les epales la sina bouéte dis quincailles et dens cit venteuis meis de mars di</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3"
                TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>mille huit cent soixante dix neuf</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4"
                TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>s aprestave a continuer a piàs la rota que de Tsaméan Chaméran l arie portâ lo a passer per Gros Breil Freyan et La Bedegaz devant que arrever i borg de Tsamboa Chambave</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5"
                TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts261">
                <ANNOTATION_VALUE>L ére toteun restâ incora un moment a avetchier avouì bien de curiositâ les dous Anglés beichàs de la diligensa avouì liu De cen que l ayet compreis s arretavont an neit i Londres devant que monter su per la Votornentse Valtournenche et apris aler canque i Breuil per vére la Gran Becca lo Mont Cervin</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
                TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts335">
                <ANNOTATION_VALUE>Drola de seison p aler fére cit voyadzo avouì la nei que dejet incora lei étre per lé toteun semblavont bien aprestâs et l ayant detsardjà bagadzos sacs et pistoques sariant les alpenstocks per les Votornens</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts399">
                <ANNOTATION_VALUE>Gepin l ére restâ les avetchier en se demandent cenque poussave çales dzens a venir de louen paré per vére et de coup grimpeillier su per les montagnes an pachon inutila</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts400" TIME_SLOT_REF2="ts573">
                <ANNOTATION_VALUE>Liu is montagnes et is rouéses de la Valada d Outa l ayet jamis baillà trop fei l ére bin dza lo second coup que vegnave mis l ére todzor restâ bâs per la plana l ayet frecantâ renque les veladzos lo long de Djouére la Doiree Baltée et l ére inco gninca alâ canque en Veulla Aoste Magara c it an l arie feit lo vu que l ére quase en tren de decider de rester inque et pamis torner en derrier a son pays</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts574" TIME_SLOT_REF2="ts639">
                <ANNOTATION_VALUE>La localitâ yeu l ére neissu l ayet nom Casale Corte Cerro Cäsàal dlä Cort Cèrä i veladzo Ramate fejet comeuna avouì Gravellona Toce et per simplicitâ lei dijant tcheuts renque Casal</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10"
                TIME_SLOT_REF1="ts640" TIME_SLOT_REF2="ts699">
                <ANNOTATION_VALUE>Liu l ére donc cougnu coment Gepin ed Casal garçon de Teresa Peroni figlio di N N di couté de papa defenichon di certificat de neissance que l ayet</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11"
                TIME_SLOT_REF1="ts700" TIME_SLOT_REF2="ts787">
                <ANNOTATION_VALUE>pesâ lei pâs poca dens la via et martchand ambulant martchand mat come l ayant surnomà l an passà a Veullafrantse Villefranche de Quart yeu l ére diret belle cit an apris s étre arretâ magara un dzor per lo borg de Nus</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts788" TIME_SLOT_REF2="ts995">
                <ANNOTATION_VALUE>De Casal que l est su i nord di lac d Orta et pâs louen di lac Major a peu prés a chouessanta kilometres de Novara l ére parti a piàs dous dzors devant L ére passâ a Biella et apris bâs en Ivreya yeu l ayet decidâ p aler canque a Tsateillon de voyadjier pi comodo Se predze de prolondjier lo tsemin de fer magara de ce quaques ans tsandzeret tot mis per lo moment incora di grace que lei sont les voéteures a tseval Gepin quaque tsousa l ayet vendu et cen l ayet permetu lei de se payier lo beillet</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13"
                TIME_SLOT_REF1="ts996" TIME_SLOT_REF2="ts1077">
                <ANNOTATION_VALUE>Treinaye per quatro tsevals robustos et plens de gorgoillons la voéteura ou pi simplamente la pousta coment lei dijant tcheuts l at huet places dedens et d atres treis defoura su lo banc derrier lo posteillon que meine les tsevals</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14"
                TIME_SLOT_REF1="ts1078" TIME_SLOT_REF2="ts1229">
                <ANNOTATION_VALUE>Cit inque l est un petchout homo pansu et atot les dzoutes rodzes que l at an cornetta de loton et an boursa a travers l epala Achatâ su hât varde dens la man gotse la pougnà de breudes et dens la dreite un long fouet de cuir que arreve comodo a la seconda rentse de tsevals et memo a la treijema quand fàt l apeillier a Verrès per passer la poyà de la Mondzoveta</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15"
                TIME_SLOT_REF1="ts1230" TIME_SLOT_REF2="ts1289">
                <ANNOTATION_VALUE>Gepin l ayet voyadjà defoura achatâ su lo banc tchica pi fret mis mouens tcher paré avouì renque treis livres l ayet feit lo trajet d Ivreya a Tsateillon</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16"
                TIME_SLOT_REF1="ts1290" TIME_SLOT_REF2="ts1417">
                <ANNOTATION_VALUE>La coteuma passave l hiver a fére quaques pégnos travails per les grandzes de Casal mis deis que l ayet avu vingt ans l ayet etot comenchà quand arrevave lo forié le printemps a se tramouer d an localitâ a l atra vendre des motcheus des botons des ribans des euilles et des euillettes tot cen que pouchet interesser is fenes de meison</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17"
                TIME_SLOT_REF1="ts1418" TIME_SLOT_REF2="ts1571">
                <ANNOTATION_VALUE>Dapremier l ére alâ su per la Val d Ossola di couté di Simplon l an apris l ayet viondâ per les Ivreyes et lo Canaveis et l an passâ l atrachon per la Valada d Outa l ayet portâ lo canque a Quart Et lé l ayet intenchon de torner magara finque de rester ara que l ayet quase vingt et quatr ans mama Teresa l ére morta et ren lo llietave pamis avouì Casal</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18"
                TIME_SLOT_REF1="ts1572" TIME_SLOT_REF2="ts1673">
                <ANNOTATION_VALUE>L est pâs que l ache lamâ vendre des botons mis a fére cit travail belle se voyadzave tsardjà en atendent se rontave pâs l etsena pués vejet todzor des louàs deferents et surtot et l ére cen que lei interessave depi cougnissave de dzens et recontrave bien de females</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19"
                TIME_SLOT_REF1="ts1674" TIME_SLOT_REF2="ts1731">
                <ANNOTATION_VALUE>Mariayes ou pâs dzovenes ou dza belle tchica eutre dens l adzo sayet preu liu coment fére l est franc lo cas de lo dire a apeillier boton</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20"
                TIME_SLOT_REF1="ts1732" TIME_SLOT_REF2="ts1801">
                <ANNOTATION_VALUE>En poca paroles se l ache falu defenir noutro Gepin on arie deut femelu content de se tramouer poca voya de travaillier bona paleta et todzor prest a profiter dis bagues et dis situachons</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21"
                TIME_SLOT_REF1="ts1802" TIME_SLOT_REF2="ts1871">
                <ANNOTATION_VALUE>Dous dzors apris lo vouelà arrever a Veullafrantse a la gabella di veladzo yeu on acapave de tabaque fejet cantina et l ayet etot comestiblo et tsambres a loyier L est entrâ en tsantent</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22"
                TIME_SLOT_REF1="ts1872" TIME_SLOT_REF2="ts1893">
                <ANNOTATION_VALUE>Oh Bundì bundì bundì ncura na volta ncura na volta</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23"
                TIME_SLOT_REF1="ts1894" TIME_SLOT_REF2="ts1905">
                <ANNOTATION_VALUE>Oh Bondzor incora un coup</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a24"
                TIME_SLOT_REF1="ts1906" TIME_SLOT_REF2="ts1929">
                <ANNOTATION_VALUE>Oh Bundì bundì bundì ncura na volta et peui pa pi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25"
                TIME_SLOT_REF1="ts1930" TIME_SLOT_REF2="ts1947">
                <ANNOTATION_VALUE>Oh Bondzor inco un coup et apris pamis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26"
                TIME_SLOT_REF1="ts1948" TIME_SLOT_REF2="ts2061">
                <ANNOTATION_VALUE>Gentile Mezzo lo cantenier per les cliants Djentilino un beteucant Canavesan que deis quaques ans vardave lo comerce l ére en tren de venir su per les etchelirs de la crota avouì des boteilles per les mans et a sentir tsanter cala Munfrina l ayet dza recougnu lo devant que lo vére lo mostatsu martchand mat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27"
                TIME_SLOT_REF1="ts2062" TIME_SLOT_REF2="ts2087">
                <ANNOTATION_VALUE>Hué bundì Gepin l at deut alura d rive co st an</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28"
                TIME_SLOT_REF1="ts2088" TIME_SLOT_REF2="ts2105">
                <ANNOTATION_VALUE>Bondzor Gepin adonc t arreve inco cit an</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a29"
                TIME_SLOT_REF1="ts2106" TIME_SLOT_REF2="ts2137">
                <ANNOTATION_VALUE>Mah sì l è già doi o tre dî che sun rivà a Casti un</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30"
                TIME_SLOT_REF1="ts2138" TIME_SLOT_REF2="ts2163">
                <ANNOTATION_VALUE>Ouè l est dza dous treis dzors que sé arrevâ a Tsateillon</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31"
                TIME_SLOT_REF1="ts2164" TIME_SLOT_REF2="ts2173">
                <ANNOTATION_VALUE>Tut bin Tot amodo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32"
                TIME_SLOT_REF1="ts2174" TIME_SLOT_REF2="ts2193">
                <ANNOTATION_VALUE>Sun sempre carià me n asu ma va bin</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33"
                TIME_SLOT_REF1="ts2194" TIME_SLOT_REF2="ts2213">
                <ANNOTATION_VALUE>Sé todzor tchardjâ come un âno mis vat bin</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34"
                TIME_SLOT_REF1="ts2214" TIME_SLOT_REF2="ts2277">
                <ANNOTATION_VALUE>Gepin l ayet en atendent pousâ la sina tsardze et s ére achatâ a tabla devant lo quart et lo veiro que Djentilino l ayet servi lei Et l at continuâ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35"
                TIME_SLOT_REF1="ts2278" TIME_SLOT_REF2="ts2363">
                <ANNOTATION_VALUE>L un pi nen veuia ed vende ed butun e veui pi nen artorné a Casal Finì sta gira piantu lì tut Dz ei pamis voya de vendre des botons et vouis pamis torner a Casal Fenet cit tor planto lé tot</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36"
                TIME_SLOT_REF1="ts2364" TIME_SLOT_REF2="ts2387">
                <ANNOTATION_VALUE>Oi Cué ch a è arivà Euh Cenque te capite ti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37"
                TIME_SLOT_REF1="ts2388" TIME_SLOT_REF2="ts2499">
                <ANNOTATION_VALUE>L un da manca ed cambié ora che a me mort mia mare Te sas nen se quaicadun a serca domesti Fina ti d pudrise avei da manca Dz ei fata de tchandjier ara que mama l est morta Te sas pâs se quaqu un tsertse un domesteco Magara té etot te pouvrie aveir fata</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38"
                TIME_SLOT_REF1="ts2500" TIME_SLOT_REF2="ts2583">
                <ANNOTATION_VALUE>Varda Gepin adess no ma quand me fieul Vitorio ch a l a vint an a va suldà puduma parlene Avetsa Gepin ara na mis quand mon garçon Vitor que l at vingt ans vat pi sordat nos pouvens nen predjier</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a39"
                TIME_SLOT_REF1="ts2584" TIME_SLOT_REF2="ts2703">
                <ANNOTATION_VALUE>Rassurâ per çales paroles Gepin l at comandâ un atro quart et reservâ an tsambra per quaques dzors lo temps de fére lo tor de Veullafrantse d aler canque eutre i Villair de veseuter tcheuts les veladzos dis Cleyves et magara d aler finque su canque is Treis Veulles Trois Villes yeu l ére pâs alà l an devant</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40"
                TIME_SLOT_REF1="ts2704" TIME_SLOT_REF2="ts2727">
                <ANNOTATION_VALUE>A che nom l at demandâ Djentilino e marcu la stansia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41"
                TIME_SLOT_REF1="ts2728" TIME_SLOT_REF2="ts2743">
                <ANNOTATION_VALUE>A quint nom marco dzo la tsambra</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42"
                TIME_SLOT_REF1="ts2744" TIME_SLOT_REF2="ts2875">
                <ANNOTATION_VALUE>Se d basta nen Gepin ed Casal buta pura Giuseppe Peroni e se d veule giunta Antonio Ma dime ancura na roba cula cambrera che t avie te l a pi nen Se te baste pâs Gepin de Casal beuta maque Giuseppe Peroni et se te vous adjeunta etot Antonio Mis dis me inco an baga çala serventa que t ayès te l as pamis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a43"
                TIME_SLOT_REF1="ts2876" TIME_SLOT_REF2="ts2913">
                <ANNOTATION_VALUE>Chi Frousina la cuscrita ed me fieul No chila a lè quasi n an ch a ven pi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44"
                TIME_SLOT_REF1="ts2914" TIME_SLOT_REF2="ts2951">
                <ANNOTATION_VALUE>Qui Frosine la coscrita de mon garçon Na çala l est dza belle un an que vint pamis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45"
                TIME_SLOT_REF1="ts2952" TIME_SLOT_REF2="ts2957">
                <ANNOTATION_VALUE>Darmagi Damadzo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46"
                TIME_SLOT_REF1="ts2958" TIME_SLOT_REF2="ts2989">
                <ANNOTATION_VALUE>Se d veule parleje d poule andé cerchela a sta cun sua mare a Chantian</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47"
                TIME_SLOT_REF1="ts2990" TIME_SLOT_REF2="ts3025">
                <ANNOTATION_VALUE>Se te vous lei predjier te pous aler la tsertchier reste su a Tsantignan avouì la mama</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48"
                TIME_SLOT_REF1="ts3026" TIME_SLOT_REF2="ts3119">
                <ANNOTATION_VALUE>Sicur che vun an serca Cheur que la tsertso l at pensâ Gepin perqué çales daves caresses que l ayet feit lei l an passâ l ayant pâs gavâ lei la voya d aveir quaque tsousa depi de çala dzoveneta tchica simpleta mis timida et jantila</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49"
                TIME_SLOT_REF1="ts3120" TIME_SLOT_REF2="ts3135">
                <ANNOTATION_VALUE>Paré l at pâs perdu de temps</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50"
                TIME_SLOT_REF1="ts3136" TIME_SLOT_REF2="ts3179">
                <ANNOTATION_VALUE>Lo dzor apris l at feit un pégno tor per Veullafrantse et apris l at vito atacâ su per les Cleyves</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a51"
                TIME_SLOT_REF1="ts3180" TIME_SLOT_REF2="ts3183">
                <ANNOTATION_VALUE>Lo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52"
                TIME_SLOT_REF1="ts3184" TIME_SLOT_REF2="ts3189">
                <ANNOTATION_VALUE>vingt sept</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53"
                TIME_SLOT_REF1="ts3190" TIME_SLOT_REF2="ts3235">
                <ANNOTATION_VALUE>mars l at feit Vieille Morta et Tsamplan et apris Poueille Povil Verney Massuc Peillou Epillod et canque a Tsantignan Chantignan lo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54"
                TIME_SLOT_REF1="ts3236" TIME_SLOT_REF2="ts3241">
                <ANNOTATION_VALUE>vingt huit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55"
                TIME_SLOT_REF1="ts3242" TIME_SLOT_REF2="ts3283">
                <ANNOTATION_VALUE>l at feit lo tor per Chito Chétoz et Séan Séran et apris l est torna alâ a Tsantignan lo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56"
                TIME_SLOT_REF1="ts3284" TIME_SLOT_REF2="ts3289">
                <ANNOTATION_VALUE>vingt neuf</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57"
                TIME_SLOT_REF1="ts3290" TIME_SLOT_REF2="ts3369">
                <ANNOTATION_VALUE>t alâ sarie l est alâ diret a Argnou Argnod et Iclioù Eclou et apris en tornent bâs s est torna arretà a Tsantignan a cen de Marte Pléod an petchouda et prima fena de pi de chouessant ans</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58"
                TIME_SLOT_REF1="ts3370" TIME_SLOT_REF2="ts3399">
                <ANNOTATION_VALUE>Bien cheur passave pâs per lieu qui lei interessave l ére Frosine sina feille</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59"
                TIME_SLOT_REF1="ts3400" TIME_SLOT_REF2="ts3553">
                <ANNOTATION_VALUE>Les daves restavont soletes apris que lo papa Sèbe Jean Eusèbe Berthod bien pi viou que Marte l ére dza quaques ans que l ére mort et que les daves sereus pi vieilles Blèse et Marguerite et lo mailleui lo premier neissu Vincent s érant tcheuts mariâs Vincent itave liu etot a Tsantignan dimenque les daves sereus l érant una su a Porsan de Treis Veulles et l atra a Morgona a La Montagne de Quart</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60"
                TIME_SLOT_REF1="ts3554" TIME_SLOT_REF2="ts3659">
                <ANNOTATION_VALUE>Marte et Frosine restavont dens un pouro beu avouì an tchivra et daves feyes et vequechavont di poca revenu de cices quatro bocons de prâ que l ayant de cen que lei baillave lo courtil devant les mitchos et de la rente d un par de tsatagniers eutre i fond di veladzo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61"
                TIME_SLOT_REF1="ts3660" TIME_SLOT_REF2="ts3817">
                <ANNOTATION_VALUE>Gepin l ére pâs tant restâ a combiner lo patatrac et cit dzor dimenque Marte l ére alaye bâs canque a Séran tsertchier des traplants l at impindu Frosine dens lo pailleur et lé sensa que lieu l ache avu la force et lo coradzo de dire ni ouè ni na l at djésua la su lo fen et on pout pâs franc dire se l at preisa la de force ou l at feit lei l amour</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62"
                TIME_SLOT_REF1="ts3818" TIME_SLOT_REF2="ts3931">
                <ANNOTATION_VALUE>Frosine l at pâs bien avu façon de comprende se l est itâ un moment d amour ou dequé et se l at lamâ ou pâs cala baga que l ayet jamis feit devant Sayet renque que l ayet sentu mal que l ayet seinâ et que dejet tot catchier devant que mama Marte fuche tornaye</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63"
                TIME_SLOT_REF1="ts3932" TIME_SLOT_REF2="ts3987">
                <ANNOTATION_VALUE>Tota tremblenta l at adonc quetâ Gepin se debroillier dimenque a galop l est tornaye eutre a meison Vouelà come l est itâ lo sin premier coup</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64"
                TIME_SLOT_REF1="ts3988" TIME_SLOT_REF2="ts4151">
                <ANNOTATION_VALUE>Mis n ayet avu nen d atres des cices moments lo long de cit forié pi dous et mouens forchàs des coups torna i pailleur d atres vià en campagne todzor a catson de mama evident Et Frosine l ayet belle encomenchà a lo lamer cit martchand mat que en atendent l ayet quetâ de vendre sina quincaillerie et l ayet trouvâ an borna yeu rester a Poueille Per vivre fejet quaques travails de campagne surtot per la grandze dis Davisod</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65"
                TIME_SLOT_REF1="ts4152" TIME_SLOT_REF2="ts4235">
                <ANNOTATION_VALUE>Les bagues se sont complecayes coment faillet d atra part s atendre mis l est pâs itâ lo cas quand Frosine l at comenchà a aveir des ichos et des oumis sensa reison et l at pamis avu les croés dzors</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66"
                TIME_SLOT_REF1="ts4236" TIME_SLOT_REF2="ts4347">
                <ANNOTATION_VALUE>Quand pi tard lo ventro l at tot todzent conflâ l at pamis poussu nier a mama tot cen que canque adonc l ayet vardâ catchà et memo se l at pâs voulu dire qui l ére lo coupablo Marte l at preu compreis que pouchet pâs étre d atres que cit fenéant di Novareis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67"
                TIME_SLOT_REF1="ts4348" TIME_SLOT_REF2="ts4465">
                <ANNOTATION_VALUE>Les meis sont passâs et Frosine l est creissua en santé magré tot et magré que Gepin quand l at savu la novela l ache pàs voulu nen saveir de recougnitre que l ére itâ liu Morala de la marier gninca men predjier Pâs renque l ayet fenet per pamis la frecanter gninca per lei demander coment restave</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68"
                TIME_SLOT_REF1="ts4466" TIME_SLOT_REF2="ts4511">
                <ANNOTATION_VALUE>Des coups les homos son paré plantont la sement sensa critere et deicen se lavont les mans de totes les incombances chouivantes</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69"
                TIME_SLOT_REF1="ts4512" TIME_SLOT_REF2="ts4543">
                <ANNOTATION_VALUE>Quand l outon l est arrevâ Marte et la feille l ant recoueillà lo courtilladzo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70"
                TIME_SLOT_REF1="ts4544" TIME_SLOT_REF2="ts4659">
                <ANNOTATION_VALUE>tret lo tsamp dis tartifles peconâ et coueillià les tsatagnes que la meitchà l ant tsandjà per des noués su a La Montagne Et en ategnent cit popon que lo meis de diesembro l arie portâ lei s aprestavont a la freide seison et a vére arrever lo meis de novembro per les vingt ans de Frosine</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71"
                TIME_SLOT_REF1="ts4660" TIME_SLOT_REF2="ts4757">
                <ANNOTATION_VALUE>Renque que les contchos l érant vito feits en tchi leur cit meinà l ariant pâs poussu l alever D un couté la poura via se pâs quase la misere de l atro la vergogne l ariant pâs permetu de varder per todzor cit étre frouit di petchà</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72"
                TIME_SLOT_REF1="ts4758" TIME_SLOT_REF2="ts4903">
                <ANNOTATION_VALUE>Adonc que d atro pouchant ti mesater Que se possiblo Frosine l arie aprovâ de lei baillier lo sin lacé mis vito ou tard l arie falu lo ou la queter alever a una de cales fameilles que pregnont de meinàs a la varda per la resta faillet lo ou la porter en Veulla i Refujo dis pouros l Hospice de Charité yeu pregnont et assistont etot les enfants exposés ou abandonnés</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73"
                TIME_SLOT_REF1="ts4904" TIME_SLOT_REF2="ts4979">
                <ANNOTATION_VALUE>On pouvrie etot porter lé un meinà djeusto neissu et dens l anonimat belle se la rova y est pamis mis lo frére de Frosine Vincent de l abandoner franc di tot l est pâs d acord</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74"
                TIME_SLOT_REF1="ts4980" TIME_SLOT_REF2="ts5003">
                <ANNOTATION_VALUE>L est itâ paré que franc la veille de Tsalende di</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75"
                TIME_SLOT_REF1="ts5004" TIME_SLOT_REF2="ts5017">
                <ANNOTATION_VALUE>mille huit cent soixante dix neuf</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76"
                TIME_SLOT_REF1="ts5018" TIME_SLOT_REF2="ts5207">
                <ANNOTATION_VALUE>a sat heures di matin apris an neit bien trebelaye et avouì l eidzo per boneur de Térése la méresadze ou messadze sage femme dis Cleyves Frosine l at beutâ i mondo un meinà un popon Vincent s est intsardjà liu d aler denonchier régulieramente la neissance a l etat civilo et paré l at combinâ avouì dous temoens Paul Chanoux que fet lo maçon ensemblo a liu et Gédéon Perret compagnon et veseun de meison d aler bâs i Villair a la Meison Comeuna de Quart a treis et djemi de l aveprâ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77"
                TIME_SLOT_REF1="ts5208" TIME_SLOT_REF2="ts5241">
                <ANNOTATION_VALUE>Lo senteco liu memo Aimé Rosset l at registrâ lo certificat de neissance en beutent que</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78"
                TIME_SLOT_REF1="ts5242" TIME_SLOT_REF2="ts5317">
                <ANNOTATION_VALUE>dans la maison située à Chantignan au numeéro civique cing d une fille qui ne consent pas d éètre nommée est né un enfant de sexe masculin auquel elle donne le nom de Bertholla Jean Baptiste Vincent</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79"
                TIME_SLOT_REF1="ts5318" TIME_SLOT_REF2="ts5435">
                <ANNOTATION_VALUE>Bertholla nom de meison de fantasie inventà lé su dous piàs a partir de Berthod cit de la fameille que fet la declarachon Vincent tant per rapeler lo nom de qui la presente et certifie que l acoutsement l est acapitâ dens la sina meison Jean Baptiste lo veretablo nom per tota la resta de la sina via</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
