        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128"
                TIME_SLOT_REF1="ts7460" TIME_SLOT_REF2="ts7547">
                <ANNOTATION_VALUE>Sandrine etot l at voulu aler belle se en Cogne l est pâs coteuma et l at todzor chouvu la quiesse de son amour canque i derrier moment lo queur en frises lo regard assent Bert tot di long a couté de lieu</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129"
                TIME_SLOT_REF1="ts7548" TIME_SLOT_REF2="ts7571">
                <ANNOTATION_VALUE>Djeusto bien an vingtena de dzors apris la matenâ de dessando</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130"
                TIME_SLOT_REF1="ts7572" TIME_SLOT_REF2="ts7577">
                <ANNOTATION_VALUE>dix huit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131"
                TIME_SLOT_REF1="ts7578" TIME_SLOT_REF2="ts7697">
                <ANNOTATION_VALUE>janvier franc devant les patrons de Pené de Creita et de Cogne lo temps de vendre Parioula et les daves tchivres de beuter vià les feyes et de queter is Carasson lé protso les dzeleunes an Sandrine tota harbeillaye de neir s apreste a dire adjeu a Vanontey per torner bâs en tchi lieu avouì mama Fine en Sarvaneire</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132"
                TIME_SLOT_REF1="ts7698" TIME_SLOT_REF2="ts7769">
                <ANNOTATION_VALUE>Les dous fréres Goudèn César Tchedjâ et Ferdinand que sont habituâs a tramouer sont venus su atot les leudzes per porter bâs lo pi grous di megnadzement et les dous meinàs que vant dza daperleur</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133"
                TIME_SLOT_REF1="ts7770" TIME_SLOT_REF2="ts7837">
                <ANNOTATION_VALUE>Sandrine varde Blandine troussaye dens ses bras et Bert tsemene a couté de lieu atot un garbin su les epales quand lo tsemin vint pi pi bon beute pi lé dedens la petchouda</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134"
                TIME_SLOT_REF1="ts7838" TIME_SLOT_REF2="ts7943">
                <ANNOTATION_VALUE>Les Goudèn les ant escortàs canque en Cogne yeu un melatier atot un tsaret les at atendus p aler compagnie leur canque en Sarvaneire La resta les moublos de meison et les moublos de meneujier de Batista sariant pi venus les prendre pi tard d eforié atot les tsemins tchica pi dzents</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135"
                TIME_SLOT_REF1="ts7944" TIME_SLOT_REF2="ts8025">
                <ANNOTATION_VALUE>De larmes Sandrine n ayet pamis mis l at magonâ tot di long Pensave a cen que l ayet reservâ lei l an biseste et i tracas que Batista l ayet la matenâ di premier dzor de l an devant</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136"
                TIME_SLOT_REF1="ts8026" TIME_SLOT_REF2="ts8055">
                <ANNOTATION_VALUE>Quaque tsousa de bon et d atro de gramo l ayet repondu lei lieu</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137"
                TIME_SLOT_REF1="ts8056" TIME_SLOT_REF2="ts8075">
                <ANNOTATION_VALUE>Pi gramo que cen que pouchet ti lei acapiter</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138"
                TIME_SLOT_REF1="ts8076" TIME_SLOT_REF2="ts8107">
                <ANNOTATION_VALUE>Boneur que l ayet Bert a l eidjier et surtot mama Fine a l atendre</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139"
                TIME_SLOT_REF1="ts8108" TIME_SLOT_REF2="ts8131">
                <ANNOTATION_VALUE>Pensave et sangliotave de tsagrin Sandrine les joueils feiblos et fategâs</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140"
                TIME_SLOT_REF1="ts8132" TIME_SLOT_REF2="ts8151">
                <ANNOTATION_VALUE>Et tsouyave yeu pouser les piàs teta lo bâs</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
