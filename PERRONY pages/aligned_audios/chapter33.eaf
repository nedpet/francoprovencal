    <TIER LINGUISTIC_TYPE_REF="default-lt" TIER_ID="default"/>
    <TIER LINGUISTIC_TYPE_REF="default-lt" TIER_ID="Sentence">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>LO DZOR DE L N DI</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3"
                TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>mille neuf cent douze</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4"
                TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>Batista s est levâ avouì an penchére Se demandave Cenque nos reserveret ti cit an biseste que nos vegnens d apondre</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5"
                TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>Se rapelave a peu prés çales memes paroles prononchayes per lo viou Tounin l an</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
                TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts107">
                <ANNOTATION_VALUE>mille neuf cents</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>et çala penchére l ére venua quase un tracas Sayet pâs lo perqué se tant que l at predjà nen a Sandrine levaye devant que liu per sognier et etseuder Mario que pleurave en trevolent</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>Que vous te que nos reserveye l at deut Sandrine quaque tsousa de bon et d atro de gramo come tcheuts les ans Franc té que t es pâs pouerieus de ren et t es pâs fataliste te me fes cices discours</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>T âs reison sé pâs cenque m acapite nos passens pi preu inco cit an</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10"
                TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts415">
                <ANNOTATION_VALUE>Çala neit l ayant feit l amour coment lei acapitave sovent a la freide seison Sandrine l ére pâs todzor contenta mis faillet bin lo seconder cit homo di mouente l hiver dza que dens les atres seisons l ére todzor vià Tampi se sariepi arrevâ nen un atro tenir compagnie a la cobla que l ayant dza</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11"
                TIME_SLOT_REF1="ts416" TIME_SLOT_REF2="ts431">
                <ANNOTATION_VALUE>Et Batista l ére di memo avis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts467">
                <ANNOTATION_VALUE>Se Vitorien l at feit nen sat dens dies ans pensave mé ara dze sé incora louen</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13"
                TIME_SLOT_REF1="ts468" TIME_SLOT_REF2="ts577">
                <ANNOTATION_VALUE>Sensa nen predjier depi que cen Sandrine l at pâs falu atendre la fin de février et lo retor di solei i Tsentelet de Vanontey devant que miedzor per comprendre que un atro fruit de cit amour començave torna a creitre dedens lieu devant que la fin de l an l arie tornâ acoutchier</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14"
                TIME_SLOT_REF1="ts578" TIME_SLOT_REF2="ts601">
                <ANNOTATION_VALUE>L ére çala la premiere dzenta novela de l an biseste</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15"
                TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts655">
                <ANNOTATION_VALUE>Avouì cit nouvo redzeton dedens lo ventro mis la novela per lo moment les dous l ayant vardaye la per leur Sandrine l est alaye lo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16"
                TIME_SLOT_REF1="ts656" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>sept</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17"
                TIME_SLOT_REF1="ts660" TIME_SLOT_REF2="ts689">
                <ANNOTATION_VALUE>de mars a la veille per Ferdinand lo garçon de Djèndoulén Vital lo garda</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18"
                TIME_SLOT_REF1="ts690" TIME_SLOT_REF2="ts735">
                <ANNOTATION_VALUE>L ayet maque doze ans cit pouro meinà et l ére mort endzevrâ pan pleuresia ou an pormonite se sât pâs bien</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19"
                TIME_SLOT_REF1="ts736" TIME_SLOT_REF2="ts841">
                <ANNOTATION_VALUE>Batista l est restâ a varder Mario et Josephine que l ayet djeusto acompli treis ans lo dzor devant et Sandrine ensemblo a tants d atres females di veladzo l at passâ la neit a preyier et consoler Condine la femala de Vital que perdave lo devant derrier de ses doze meinàs</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20"
                TIME_SLOT_REF1="ts842" TIME_SLOT_REF2="ts875">
                <ANNOTATION_VALUE>Lo dzor apris l ariant pi feit la seporteura perqué l ére dza espirâ lo dzor</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21"
                TIME_SLOT_REF1="ts876" TIME_SLOT_REF2="ts879">
                <ANNOTATION_VALUE>six</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22"
                TIME_SLOT_REF1="ts880" TIME_SLOT_REF2="ts919">
                <ANNOTATION_VALUE>eutre per la neit et la loué permet pâs de varder les defunts dous coups vingt et quatr heures</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23"
                TIME_SLOT_REF1="ts920" TIME_SLOT_REF2="ts1023">
                <ANNOTATION_VALUE>Vital l ére alâ inviter les tsantres per lo lendeman et surtot tsertchier les dzens per porter bâs a epales la quiesse canque en Cogne di mouente huet homos se pâs doze Belle se l ére un meinà sarie itâ un desoneur lo porter bâs atot an leudze ou un tsaret</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a24"
                TIME_SLOT_REF1="ts1024" TIME_SLOT_REF2="ts1095">
                <ANNOTATION_VALUE>Batista s ére bien cheur baillà disponiblo et l ére dza finque alâ ensemblo a d atres batre la vit aprester lo tsemin a cosa de cices quatro deits de nei que l érant venus</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25"
                TIME_SLOT_REF1="ts1096" TIME_SLOT_REF2="ts1233">
                <ANNOTATION_VALUE>Poca dzens toteun sariant alayes a la seporteura Gninca Condine vat pâs L est an coteuma de Cogne les fenes acompagnont pâs les quiesses i cemetchero ni de l homo ni dis parents ni d un meinà Vant is messes apris mis pâs is seporteures Condine l at toteun feichà lieu la quiesse atot lo lençul blanc lo memo que s empleye per tcheuts les morts di veladzo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26"
                TIME_SLOT_REF1="ts1234" TIME_SLOT_REF2="ts1319">
                <ANNOTATION_VALUE>Vital l ayet un garçon et treis feilles que l ayant dza passâ les trent ans daves dza mariayes una partia a Paris et çala mariaye avouì Pierre Cuaz et neissua en Sarvaneire presta a partir per l Amereca a New York</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27"
                TIME_SLOT_REF1="ts1320" TIME_SLOT_REF2="ts1401">
                <ANNOTATION_VALUE>Avouì liu nen restavont bin incora sat la pi vieille de vingt et quatr ans lo pi dzoveno de dies mis perdre cit garçon lo premier que perdave l ayet telamente engravâ lei que l ayet peina a se reprendre</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28"
                TIME_SLOT_REF1="ts1402" TIME_SLOT_REF2="ts1557">
                <ANNOTATION_VALUE>Lo pi beurt l ére que alave pamis tant d acord avouì Condine la mort de cit meinà l ayet uvert un ecrapa dens lo raport entre leur et les dous vouillant pamis rester ensemblo Condine l ayet adonc decidâ a l entrant di forié de rester bâs a Sonveulla avouì les treis pi dzovenos dimenque les quatro pi grous Jacinte la pi vieille pensave lieu a tcheuts l érant todzor su en Vanontey avouèi lou papà</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a29"
                TIME_SLOT_REF1="ts1558" TIME_SLOT_REF2="ts1623">
                <ANNOTATION_VALUE>Batista l est itâ bien protso a Vital dens cices meis per liu l ére coment lache preis la place di papa naturel que l ayet abandonâ lo et di papa adoptif</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30"
                TIME_SLOT_REF1="ts1624" TIME_SLOT_REF2="ts1685">
                <ANNOTATION_VALUE>que l ayet perdu De liu l at confiance et quand feyont servicho ensemblo l est todzor Batista que s intsardze dis devoers pi maleijàs cices pi defecilos a fére</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31"
                TIME_SLOT_REF1="ts1686" TIME_SLOT_REF2="ts1745">
                <ANNOTATION_VALUE>Vital etot lame rester avouì Batista et lo considere coment un de la sina fameille Quend t es neissu té lei repete sovent mè d avous dza na feille</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32"
                TIME_SLOT_REF1="ts1746" TIME_SLOT_REF2="ts1861">
                <ANNOTATION_VALUE>Des coups toteun trebele bin a lo governer Tant coment liu l est calmo refleichif et metodeco Batista l est instintif brivo et decidâ belle quand n at pâs fâta Coment cit coup de Layde quand Vital l est itâ coudzu de lei dire que son comportement l ére itâ pi que eisagerâ et foura de meseura</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33"
                TIME_SLOT_REF1="ts1862" TIME_SLOT_REF2="ts1939">
                <ANNOTATION_VALUE>Layde l ére an vieille fena que restave soleta a Reppià De temps en temps vegnave bin en Vanontey mis lo pi di temps l ére todzor lé a cit mayen atot sines daves tchivres et dous tsats</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34"
                TIME_SLOT_REF1="ts1940" TIME_SLOT_REF2="ts2019">
                <ANNOTATION_VALUE>Quaqu un dijet que l ére dis Bérard qui pensave dis Cuaz qui dis Cavagnet mis de quinta fameille l ére per dabon nieun sayet pâs de precis et adonc per tcheuts l ére maque la vieille dou saquetson</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35"
                TIME_SLOT_REF1="ts2020" TIME_SLOT_REF2="ts2179">
                <ANNOTATION_VALUE>Cit saquetson l ére an boursa d etofa que Layde portave todzor apris vegnave en Vanontey et l ayet lo saquetson alave bâs a la Veulla de Cogne a messa et vardave lo saquetson pendu i coudo belle p aler i courtil lo quetave pâs Et l ére todzor harbeillaye egala atot les memes vetouéres les memes soques i piàs lo memo motcheu a la teta lo memo nan p an man lo baton dens l atra lo saquetson</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36"
                TIME_SLOT_REF1="ts2180" TIME_SLOT_REF2="ts2267">
                <ANNOTATION_VALUE>Nieun l ayet jamis savu cen que vardave lé dedens et per la dire tota a bien pocas interessave mis a Batista ouè Tcheuts les coups que passave per lé mancave pâs de la cospeter et d étre provocant et maladret avouì lieu</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37"
                TIME_SLOT_REF1="ts2268" TIME_SLOT_REF2="ts2285">
                <ANNOTATION_VALUE>Qu ades vos dedens cit saquetson Layde demandave</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38"
                TIME_SLOT_REF1="ts2286" TIME_SLOT_REF2="ts2299">
                <ANNOTATION_VALUE>Ren l ére todzor la reponsa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a39"
                TIME_SLOT_REF1="ts2300" TIME_SLOT_REF2="ts2309">
                <ANNOTATION_VALUE>Tchica poca ren replecave</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40"
                TIME_SLOT_REF1="ts2310" TIME_SLOT_REF2="ts2325">
                <ANNOTATION_VALUE>Sont pâs des tines bagues dijet Layde</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41"
                TIME_SLOT_REF1="ts2326" TIME_SLOT_REF2="ts2355">
                <ANNOTATION_VALUE>Et liu insistave Ades vos des souts des secrets ou vos vardades des tsatons</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42"
                TIME_SLOT_REF1="ts2356" TIME_SLOT_REF2="ts2367">
                <ANNOTATION_VALUE>Et lieu Ren vas vià</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a43"
                TIME_SLOT_REF1="ts2368" TIME_SLOT_REF2="ts2461">
                <ANNOTATION_VALUE>Cit dzor de fin mai Vital l at assistâ magré liu a l enemo tentatif de Batista de fére uvrir lo saquetson a Layde l at finque aprovâ de lei lo imbranquier mis lieu l at pâs quetâ la preisa et l at impindu lo louen</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44"
                TIME_SLOT_REF1="ts2462" TIME_SLOT_REF2="ts2509">
                <ANNOTATION_VALUE>Vous te adzouyier que mé lei terio un crep a cit saquetson l at deut Batista a Vital en partent vià de Reppià</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45"
                TIME_SLOT_REF1="ts2510" TIME_SLOT_REF2="ts2553">
                <ANNOTATION_VALUE>Resta tchica qué l est itaye la reachon de Vital âs te pâs d atro a penser que a cen inque</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46"
                TIME_SLOT_REF1="ts2554" TIME_SLOT_REF2="ts2691">
                <ANNOTATION_VALUE>Mis Batista l at pâs baillà lei fei et en passent lo tsenail de Vijeusa l at continuâ a veillier Reppià et les mouvements de Layde canque l at vua la pouser lo saquetson su an meurdzere per se courber prendre un sapin Adonc l est itâ leste a imbranquier lo feusil et sensa que Vital l ache poussu lo empatchier l at merià et l at terià</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47"
                TIME_SLOT_REF1="ts2692" TIME_SLOT_REF2="ts2813">
                <ANNOTATION_VALUE>Lo crep l at pâs preis en plen lo saquetson l est arrevâ su lo berio desot mis l at feit lo aler per l er et lever an drola de poussa ensemblo is braillos epouvantâs de Layde Apris lo retouno s est renque sentua an voués forta et menaçanta que vegnave de Reppià Té Perrony cé te vas perir</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48"
                TIME_SLOT_REF1="ts2814" TIME_SLOT_REF2="ts2883">
                <ANNOTATION_VALUE>A cit diagnosteco fatal noutro Perrony l at reagi quase en rient dimenque Vital l at pâs arretâ de lo rognier per cen que l ayet combinâ franc come se fet avouì les meinàs</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49"
                TIME_SLOT_REF1="ts2884" TIME_SLOT_REF2="ts2909">
                <ANNOTATION_VALUE>Que besoen avés te de tirer et de t aterier çala maledechon</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50"
                TIME_SLOT_REF1="ts2910" TIME_SLOT_REF2="ts2963">
                <ANNOTATION_VALUE>Magré cen en arrevent en Vanontey Perrony l ayet pâs incora quetâ son er moqueur et Vital l ére restâ pensif et tracachà per son compagnon</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a51"
                TIME_SLOT_REF1="ts2964" TIME_SLOT_REF2="ts2989">
                <ANNOTATION_VALUE>Entrâ a meison Batista l at acapâ Sandrine en tren de preyier</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52"
                TIME_SLOT_REF1="ts2990" TIME_SLOT_REF2="ts3065">
                <ANNOTATION_VALUE>Surpreis pâs per la preyere mis per la concomitensa l at toteun cheur pâs voulu penser que preyave dza per les paroles de Layde et l est itaye Sandrine a lei gaver tot de suite la doute</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53"
                TIME_SLOT_REF1="ts3066" TIME_SLOT_REF2="ts3117">
                <ANNOTATION_VALUE>L est mort l abbé Charles Foilloley l enqueurà de la parotse de Sent Martin dis Amaveulles pensa que l ére dza enqueurà l an</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54"
                TIME_SLOT_REF1="ts3118" TIME_SLOT_REF2="ts3129">
                <ANNOTATION_VALUE>mille huit cent soixante quinze</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55"
                TIME_SLOT_REF1="ts3130" TIME_SLOT_REF2="ts3193">
                <ANNOTATION_VALUE>Ebin que lo Bon Djeu lo vardeye se vant pâs en Paradis les préres qui adonc Preya pitout per la santé de noutres meinàs l ant pi fâta leur que liu</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56"
                TIME_SLOT_REF1="ts3194" TIME_SLOT_REF2="ts3247">
                <ANNOTATION_VALUE>Mé preyo preu per leur et belle per té t es té que te preyes jamis et te pense renque a la tsasse et i Rei</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57"
                TIME_SLOT_REF1="ts3248" TIME_SLOT_REF2="ts3431">
                <ANNOTATION_VALUE>Apris se sont beutâs a tabla et tant per pâs se dementir Batista l at contâ a Sandrine que lo Grant Tsacheur de sina Majestâ lo Rei Carminati di Brambilla l ayet repondu liu memo de Roma a l avocat Valentino Delapierre Cit inque l ayet écrit an lettra dza l an passâ contre les gardes de Noasca e Ceresole que vegnavont en cé per la Vassavarentse et tsassavont eutre en tchi leur a travers lo Nivolet boquetins etagnes et tchevreils atot grous dandjier de nen fére craper per lo tsemin</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58"
                TIME_SLOT_REF1="ts3432" TIME_SLOT_REF2="ts3455">
                <ANNOTATION_VALUE>On pout comprendre tot lo desinterés de Sandrine per çala novela</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59"
                TIME_SLOT_REF1="ts3456" TIME_SLOT_REF2="ts3467">
                <ANNOTATION_VALUE>Toteun Batista l at insistâ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60"
                TIME_SLOT_REF1="ts3468" TIME_SLOT_REF2="ts3543">
                <ANNOTATION_VALUE>Sâs te cen que m at contâ Pierrot hier matin Que su per les Coutes de Tsalende di Grous Lauson l ayet vu an moteila mis l ayet pâs lo feusil apris lou stchop lei dit liu</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61"
                TIME_SLOT_REF1="ts3544" TIME_SLOT_REF2="ts3635">
                <ANNOTATION_VALUE>Adonc l at aprovâ de l apaler et smoutch et smoutch et smoutch l est ti pâs venua lei apris canque su i Camp Paré l at poussu prendre lou stchop et lei terier belle se per ceta rapina lei sont franc renque quatro souts</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62"
                TIME_SLOT_REF1="ts3636" TIME_SLOT_REF2="ts3753">
                <ANNOTATION_VALUE>Apris l at predjà lei de la guerra de Libia et di consecant abandon de la Reserva de la part de Vitor III et en tsavonent l at pi etot deut dous mots su Vitorien que dens la derriere lettra écrijet que vouillet pamis rester su a Sent Dzordo d hiver mis tsertsave an meison bâs a Veullanouva</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63"
                TIME_SLOT_REF1="ts3754" TIME_SLOT_REF2="ts3877">
                <ANNOTATION_VALUE>Di drouet de voter que ara l est itâ elardjà a tcheuts cices que l ant feit lo sordat que l ant pi de vingt et un ans et que sant lire et écrire qui sât pâs renque a partir de trent ans vu que Sandrine s ére dza levaye de tabla p aler acocoler Maio l at pâs deut ren</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64"
                TIME_SLOT_REF1="ts3878" TIME_SLOT_REF2="ts3897">
                <ANNOTATION_VALUE>Naturelamente de Layde et de Reppià gninca an parola</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65"
                TIME_SLOT_REF1="ts3898" TIME_SLOT_REF2="ts3937">
                <ANNOTATION_VALUE>Lo tsâtemps l ére en tren de passer la seison l ére itaye peisibla et lo Rei l an</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66"
                TIME_SLOT_REF1="ts3938" TIME_SLOT_REF2="ts3947">
                <ANNOTATION_VALUE>mille neuf cent douze</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67"
                TIME_SLOT_REF1="ts3948" TIME_SLOT_REF2="ts3965">
                <ANNOTATION_VALUE>l ayet quetâ tranquilos boquetins et gardes tsasse</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68"
                TIME_SLOT_REF1="ts3966" TIME_SLOT_REF2="ts4103">
                <ANNOTATION_VALUE>Sandrine s aprestave a acoutchier lo sin port l ére itâ facilo et l arie devu a peu prés tsavoner apris la meitchà de setembro quand les vatses sariant pi tornayes dzu de montagne Surtot çales di valon de l Urtier et de Grauson perqué per lo Money et lo Lauson la campagne fenichet dza a fin out ou come cit an un par de dzors pi tard</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69"
                TIME_SLOT_REF1="ts4104" TIME_SLOT_REF2="ts4107">
                <ANNOTATION_VALUE>Lo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70"
                TIME_SLOT_REF1="ts4108" TIME_SLOT_REF2="ts4111">
                <ANNOTATION_VALUE>deux</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
